digraph framework {
  graph [rankdir=LR, bgcolor="white", pad="0.12", nodesep="0.30", ranksep="0.46",
         fontname="Helvetica", splines=true];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#0072B2",
        penwidth=1.4, fontname="Helvetica", fontsize=10, margin="0.10,0.06"];
  edge [color="#555555", penwidth=1.2, arrowsize=0.7, fontname="Helvetica",
        fontsize=8, fontcolor="#333333"];

  dA [label="2019 site A\n20,336 records\nrecord-disjoint split", color="#0072B2"];
  score [label="Causal score model\ntrained on A train only", color="#009E73"];
  sA [label="A scores\nvalidation / calibration / test", color="#0072B2"];
  policy [label="Stateful alarm policy\nthreshold · refractory · escalation", color="#E69F00"];
  loss [label="Patient loss\nalarms per patient-day", color="#E69F00"];
  cal [label="Patient-blocked\nfinite-grid UCB\n(α = 0.10)", color="#CC79A7"];
  thr [label="Certified threshold\nor exact no-alarm fallback", color="#CC79A7"];
  dB [label="2019 site B\n20,000 records\nexternal audit", color="#D55E00"];
  sB [label="Frozen scorer\nB scores", color="#009E73"];
  audit [label="Same-threshold audit\nsensitivity · alarm rate · lead time", color="#D55E00"];

  dA -> score -> sA -> policy -> loss -> cal -> thr;
  score -> sB [label="frozen weights", style=dashed];
  dB -> sB;
  sB -> audit [label="score shift"];
  thr -> audit [label="no target calibration", style=dashed];
  { rank=same; dA; score; sA; }
  { rank=same; policy; loss; cal; thr; }
  { rank=same; dB; sB; audit; }
}
